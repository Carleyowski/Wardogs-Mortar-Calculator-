# Skopiuj ten plik jako ".env" i uzupełnij prawdziwymi danymi z Discord Developer Portal.

# Discord Developer Portal -> Twoja aplikacja -> Bot -> Token
DISCORD_TOKEN=tu_wklej_token_bota

# Discord Developer Portal -> Twoja aplikacja -> General Information -> Application ID
CLIENT_ID=tu_wklej_client_id

# Opcjonalnie: ID Twojego serwera testowego (klik prawym na nazwę serwera w Discordzie -> Kopiuj ID,
# wymaga włączonego trybu developera w ustawieniach Discorda).
# Zostaw puste, jeśli chcesz zarejestrować komendę globalnie (dłużej się propaguje, do ~1h).
GUILD_ID=tu_wklej_guild_id
