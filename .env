# Copy this file to ".env" and fill in real values from the Discord Developer Portal.
# NEVER commit the real ".env" file to GitHub - it contains secrets.

# Discord Developer Portal -> Your Application -> Bot -> Token
DISCORD_TOKEN=your_bot_token_here

# Discord Developer Portal -> Your Application -> General Information -> Application ID
CLIENT_ID=your_application_id_here

# Optional: your test server ID (right-click server name in Discord -> Copy Server ID,
# requires Developer Mode enabled in Discord settings).
# Leave empty to register the command globally (takes up to ~1h to propagate).
GUILD_ID=your_test_server_id_here
